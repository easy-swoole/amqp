{
    "name": "easyswoole/amqp",
    "description": "A coroutine AMQP 0-9-1 client for Swoole",
    "type": "library",
    "keywords": [
        "swoole",
        "framework",
        "async",
        "easyswoole",
        "amqp"
    ],
    "homepage": "https://www.easyswoole.com/",
    "license": "Apache-2.0",
    "authors": [
        {
          "name": "YF",
          "email": "291323003@qq.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-swoole": ">=5.1"
    },
    "require-dev": {
        "easyswoole/swoole-ide-helper": "^1.1",
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "EasySwoole\\AMQP\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": { "EasySwoole\\AMQP\\Tests\\": "tests/" }
    },
    "scripts": { "test": "phpunit" }
}
